# ─── LLM Configuration ───────────────────────────────────────────────────────
# OpenAI, Anthropic (via compatible endpoint), or Ollama (set base_url accordingly)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# For Google Gemini (via OpenAI-compatible endpoint):
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# For Ollama (local, no API key needed):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ─── App Configuration ────────────────────────────────────────────────────────
APP_PORT=8000
DB_PATH=bugcopilot.db

# Rate limit between passive recon requests (seconds)
RATE_LIMIT_DELAY=1.5

# NVD API key (optional — increases rate limit from 5 req/30s to 50 req/30s)
# Get free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
